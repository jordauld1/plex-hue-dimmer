# --- Hue bridge -------------------------------------------------------------
# Bridge IP. Find it at https://discovery.meethue.com/ or in the Hue app
# (Settings > My Hue system > Bridge).
HUE_BRIDGE=192.168.1.x
# Press the bridge's link button, then within 30s:
#   docker compose run --rm plex-hue-dimmer python plex_hue_dimmer.py pair
HUE_APP_KEY=
# Room or zone to control, as named in the Hue app. Blank = the only one there.
# `docker compose run --rm plex-hue-dimmer python plex_hue_dimmer.py groups` lists them.
HUE_GROUP=

# --- Plex -------------------------------------------------------------------
# Players that should dim the lights: comma-separated names or uuids, as Plex
# reports them. Leave blank at first, play something, and copy them from
# `docker compose logs`. Blank = log only, change nothing.
PLEX_PLAYERS=
# Only react to these Plex accounts (comma-separated). Blank = anyone.
PLEX_USERS=
# Metadata types that count as watching. Music and trailers are left out.
MEDIA_TYPES=movie,episode
# Optional shared secret: the webhook URL then needs ?token=<this>.
WEBHOOK_TOKEN=

# --- Behaviour (brightness in %, times in seconds) -------------------------
DIM_LEVEL=15
# On pause, go part-way back up (never brighter than before playback).
PAUSE_LEVEL=50
# Wait this long after a pause before brightening, so a quick pause doesn't flicker.
PAUSE_DELAY=5
# Wait this long after you stop something part-way through before restoring.
STOP_DELAY=0
# Wait this long after something finishes (Plex counted it as watched) before
# restoring. If the next episode autoplays in the meantime, the lights never move.
FINISHED_DELAY=15
DIM_TRANSITION=3
PAUSE_TRANSITION=2
RESTORE_TRANSITION=4
# A player with no events for this long is treated as stopped (e.g. it crashed).
STALE_HOURS=8

# --- Container --------------------------------------------------------------
PORT=8095
# 127.0.0.1 if Plex runs on this host; 0.0.0.0 if it's elsewhere on your LAN.
BIND=127.0.0.1
UID_GID=1000:1000
LOG_LEVEL=INFO
